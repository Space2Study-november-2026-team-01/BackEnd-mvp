NODE_ENV=development

SERVER_PORT=3000
SERVER_URL=http://localhost:3000
CLIENT_URL=http://localhost:3001
COOKIE_DOMAIN=localhost

# MongoDB installed on this machine.
MONGODB_URL=mongodb://127.0.0.1:27017/sp_project
# MongoDB from Docker, when this API runs on the host. Compose itself does not use this URL.
# MONGODB_URL=mongodb://127.0.0.1:27018/sp_project

JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d
JWT_RESET_SECRET=change-me-reset-secret
JWT_RESET_EXPIRES_IN=1h
JWT_CONFIRM_SECRET=change-me-confirm-secret
JWT_CONFIRM_EXPIRES_IN=1d

# Used to seed the super admin and to send mail through Gmail OAuth.
MAIL_USER=admin@example.com
MAIL_PASS=change-me-password
MAIL_FIRSTNAME=Admin
MAIL_LASTNAME=User
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_REDIRECT_URI=https://developers.google.com/oauthplayground

# Optional Azure Blob settings. Leave empty when storage is not used.
STORAGE_ACCOUNT=
ACCESS_KEY=
AZURE_HOST=
