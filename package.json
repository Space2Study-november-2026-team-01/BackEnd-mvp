{
  "name": "sp_project_be",
  "version": "0.0.1",
  "description": "Space2Study backend API",
  "main": "src/app.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js --legacy-watch",
    "test": "jest --maxWorkers=1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "prepare": "husky || true",
    "pre-commit": "lint-staged",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "author": "SoftServe ITA",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.17.0",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-sonar-reporter": "^2.0.0",
    "lint-staged": "^15.5.2",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cron": "^3.5.0",
    "dotenv": "^16.6.1",
    "email-templates": "^12.0.3",
    "express": "^4.21.2",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "mongoose": "^6.13.8",
    "multer": "^2.5.0",
    "nodemailer": "^6.10.1",
    "pug": "^3.0.3",
    "winston": "^3.17.0",
    "winston-mongodb": "^5.1.1"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
